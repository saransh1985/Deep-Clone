<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>eHS_Birthdate_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>PersonBirthdate &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>PersonBirthdate</errorDisplayField>
    <errorMessage>Birthdate cannot be a future date.</errorMessage>
</ValidationRule>
