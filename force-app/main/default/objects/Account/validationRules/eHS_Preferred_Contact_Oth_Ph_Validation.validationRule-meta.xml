<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>eHS_Preferred_Contact_Oth_Ph_Validation</fullName>
    <active>true</active>
    <description>Checks if Other Phone field is populated when Phone is selected as Preferred method of contact</description>
    <errorConditionFormula>AND(
    OR(
        $RecordType.DeveloperName = &quot;Citizen&quot;,
        $RecordType.DeveloperName = &quot;eHS_College_Credentialed_Provider&quot;
    ),
    ISPICKVAL(eHS_Preferred_Contact_Method__pc, &quot;Other Phone&quot;),
    ISBLANK(PersonOtherPhone)
)</errorConditionFormula>
    <errorDisplayField>PersonOtherPhone</errorDisplayField>
    <errorMessage>Other Phone is required when Preferred Contact Method is Other Phone.</errorMessage>
</ValidationRule>
